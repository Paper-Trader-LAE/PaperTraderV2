<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_card_dark"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_marginBottom="8dp"
    android:layout_height="wrap_content">

    <!-- Header row: author + vote column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/commentAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/commentTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · 2m ago"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Vote column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/commentUpvote"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_up"
                android:contentDescription="Upvote"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/commentVoteCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />

            <ImageView
                android:id="@+id/commentDownvote"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_down"
                android:contentDescription="Downvote"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Comment body -->
    <TextView
        android:id="@+id/commentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comment text goes here..."
        android:textColor="#DDDDDD"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <!-- Footer: reply + share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/commentReply"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_comment"
            android:contentDescription="Reply"
            app:tint="#666666" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#666666"
            android:textSize="12sp"
            android:paddingStart="4dp"
            android:paddingEnd="14dp" />

        <ImageView
            android:id="@+id/commentShare"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bookmark"
            android:contentDescription="Share"
            app:tint="#666666" />
    </LinearLayout>

</LinearLayout>